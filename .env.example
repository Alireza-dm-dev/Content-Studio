# Copy to .env and fill in real values. Never commit .env.

# --- Database (SQLite) -------------------------------------------------
# Relative paths resolve to the project root, so this is <root>/dev.db.
# On the server, prefer an absolute path outside the deploy directory, e.g.
# DATABASE_URL="file:/var/data/content-studio/prod.db"
DATABASE_URL="file:./dev.db"

# --- Auth / bootstrap admin -------------------------------------------
OWNER_ADMIN_EMAIL=""
OWNER_ADMIN_PASSWORD=""
OWNER_ADMIN_NAME=""

# --- AI providers ------------------------------------------------------
# OPENAI_API_KEY is normally stored in the Settings table via /api/settings;
# this env var is only a fallback.
OPENAI_API_KEY=""
HIGGSFIELD_API_KEY=""

# --- Google Drive export ----------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Published-post webhook (n8n) -------------------------------------
N8N_PUBLISHED_POST_WEBHOOK_URL=""

# --- Published-post media delivery (SFTP) ------------------------------
PUBLISHED_MEDIA_FTP_HOST=""
PUBLISHED_MEDIA_FTP_PORT="22"
PUBLISHED_MEDIA_FTP_USER=""
PUBLISHED_MEDIA_FTP_PASSWORD=""
PUBLISHED_MEDIA_REMOTE_BASE=""
PUBLISHED_MEDIA_PUBLIC_BASE_URL=""
