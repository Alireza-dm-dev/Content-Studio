generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Brand {
  id                     String   @id @default(cuid())
  name                   String
  website                String?
  instagramPage          String?
  linkedinPage           String?
  facebookPage           String?
  businessLocation       String?
  businessType           String?
  mainServicesOrProducts String?
  targetAudience         String?
  brandTone              String?
  brandVisualStyle       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  brandIdentities          BrandIdentity[]
  uploadedFiles            UploadedFile[]
  contentCalendars         ContentCalendar[]
  generatedPrompts         GeneratedPrompt[]
  referenceImageAnalyses   ReferenceImageAnalysis[]
  combinedVisualDirections CombinedVisualDirection[]
  videoStoryboards         VideoStoryboard[]
  generatedMedia           GeneratedMedia[]
  publishedPosts           PublishedPost[]
  brandAssignments         BrandAssignment[]
  brandMemberships         BrandMembership[]
  workspaceReviews         WorkspaceReview[]
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  role             String    @default("user")
  isActive         Boolean   @default(true)
  passwordHash     String
  sessionToken     String?   @unique
  sessionExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  brandAssignments        BrandAssignment[]
  brandMemberships        BrandMembership[]
  publishedPostComments   PublishedPostComment[]
  workspaceReviewsCreated WorkspaceReview[]
  uploadedFiles           UploadedFile[]
}

model BrandAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, brandId])
  @@index([userId])
  @@index([brandId])
}

model BrandMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  role      String   @default("calendar_editor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, brandId])
  @@index([userId])
  @@index([brandId])
}

model BrandIdentity {
  id              String   @id @default(cuid())
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  jsonOutput      String?
  editableSummary String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  combinedVisualDirections CombinedVisualDirection[]
}

model UploadedFile {
  id                   String           @id @default(cuid())
  brandId              String?
  brand                Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  calendarPostId       String?
  calendarPost         CalendarPost?    @relation(fields: [calendarPostId], references: [id], onDelete: SetNull)
  calendarId           String?
  calendar             ContentCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  fileName             String
  filePath             String
  fileType             String?
  purpose              String?
  sizeBytes            Int?
  extractedText        String?
  extractionStatus     String?
  extractionError      String?
  wasTruncated         Boolean          @default(false)
  interpretationJson   Json?
  interpretationStatus String?
  interpretationError  String?
  interpretationModel  String?
  interpretedAt        DateTime?
  expiresAt            DateTime?
  createdById          String?
  createdBy            User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())

  referenceImageAnalyses ReferenceImageAnalysis[]

  @@index([calendarId])
  @@index([calendarPostId])
  @@index([createdById])
  @@index([expiresAt])
  @@index([extractionStatus])
  @@index([interpretationStatus])
}

model ContentCalendar {
  id                 String   @id @default(cuid())
  brandId            String?
  brand              Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  title              String
  platform           String?
  timePeriod         String?
  mainMonthlySubject String?
  mainGoal           String?
  mainOfferOrMessage String?
  sourceMaterial     String?
  status             String   @default("draft")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  posts                    CalendarPost[]
  generatedPrompts         GeneratedPrompt[]
  videoStoryboards         VideoStoryboard[]
  referenceImageAnalyses   ReferenceImageAnalysis[]
  combinedVisualDirections CombinedVisualDirection[]
  uploadedFiles            UploadedFile[]
}

model CalendarPost {
  id                          String          @id @default(cuid())
  calendarId                  String
  calendar                    ContentCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  postNumber                  Int?
  date                        DateTime?
  platform                    String?
  format                      String?
  suggestedHook               String?
  mainAngleAndCoreMessage     String?
  suggestedCaption            String?
  hashtags                    String?
  contentStructure            String?
  visualDirection             String?
  outputImageTextRequirements String?
  inspirationSource           String?
  referenceLink               String?
  adaptationNote              String?
  contentOrigin               String?
  postData                    String?
  status                      String          @default("draft")
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  uploadedFiles    UploadedFile[]
  generatedPrompts GeneratedPrompt[]
  videoStoryboards VideoStoryboard[]
  generatedMedia   GeneratedMedia[]
}

model VideoStoryboard {
  id                 String           @id @default(cuid())
  brandId            String?
  brand              Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  calendarId         String?
  calendar           ContentCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarPostId     String?
  calendarPost       CalendarPost?    @relation(fields: [calendarPostId], references: [id], onDelete: SetNull)
  rawInput           String?
  storyboardOutput   String?
  approvedStoryboard String?
  status             String           @default("draft")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model GeneratedPrompt {
  id             String           @id @default(cuid())
  brandId        String?
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  calendarId     String?
  calendar       ContentCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarPostId String?
  calendarPost   CalendarPost?    @relation(fields: [calendarPostId], references: [id], onDelete: SetNull)
  type           String?
  mode           String?
  targetTool     String?
  rawInput       String?
  referenceData  String?
  finalPrompt    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  generatedMedia GeneratedMedia[]
}

model PromptTemplate {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  category            String?
  templateText        String
  defaultTemplateText String
  outputType          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ReferenceImageAnalysis {
  id             String           @id @default(cuid())
  brandId        String?
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  calendarId     String?
  calendar       ContentCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarPostId String?
  uploadedFileId String?
  uploadedFile   UploadedFile?    @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  sourceFlow     String?
  jsonOutput     String?
  editedJson     String?
  status         String           @default("draft")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  combinedVisualDirections CombinedVisualDirection[]
}

model CombinedVisualDirection {
  id                       String                  @id @default(cuid())
  brandId                  String?
  brand                    Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  referenceImageAnalysisId String?
  referenceImageAnalysis   ReferenceImageAnalysis? @relation(fields: [referenceImageAnalysisId], references: [id], onDelete: SetNull)
  brandIdentityId          String?
  brandIdentity            BrandIdentity?          @relation(fields: [brandIdentityId], references: [id], onDelete: SetNull)
  calendarId               String?
  calendar                 ContentCalendar?        @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarPostId           String?
  carouselSlideNumber      Int?
  sourceFlow               String?
  textRequirements         String?
  attractionNotes          String?
  rawIdeaOrPostInformation String?
  jsonOutput               String?
  editedJson               String?
  status                   String                  @default("draft")
  finalNanobananaPrompt    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
}

model WorkspaceReview {
  id               String    @id @default(cuid())
  brandId          String
  createdById      String?
  label            String?
  tokenHash        String    @unique
  tokenLast4       String
  isActive         Boolean   @default(true)
  expiresAt        DateTime?
  includeCalendars Boolean   @default(true)
  includeInstagram Boolean   @default(true)
  includeLinkedIn  Boolean   @default(true)
  allowComments    Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  publishedPostComments PublishedPostComment[]

  @@index([brandId, createdAt])
  @@index([createdById])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model HiggsfieldModel {
  id          String   @id @default(cuid())
  modelKey    String   @unique
  label       String
  mediaType   String
  tokenCost   Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  generatedMedia     GeneratedMedia[]
  tokenLedgerEntries TokenLedgerEntry[]
}

model OperatorTokenBalance {
  id        String   @id @default(cuid())
  provider  String   @unique @default("higgsfield")
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model TokenLedgerEntry {
  id                String           @id @default(cuid())
  provider          String           @default("higgsfield")
  delta             Int
  reason            String
  balanceAfter      Int
  higgsfieldModelId String?
  higgsfieldModel   HiggsfieldModel? @relation(fields: [higgsfieldModelId], references: [id], onDelete: SetNull)
  generatedMediaId  String?
  generatedMedia    GeneratedMedia?  @relation(fields: [generatedMediaId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
}

model GeneratedMedia {
  id                String           @id @default(cuid())
  generatedPromptId String?
  generatedPrompt   GeneratedPrompt? @relation(fields: [generatedPromptId], references: [id], onDelete: SetNull)
  brandId           String?
  brand             Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  calendarPostId    String?
  calendarPost      CalendarPost?    @relation(fields: [calendarPostId], references: [id], onDelete: SetNull)
  higgsfieldModelId String?
  higgsfieldModel   HiggsfieldModel? @relation(fields: [higgsfieldModelId], references: [id], onDelete: SetNull)
  mediaType         String
  status            String           @default("pending")
  externalJobId     String?
  filePath          String?
  remoteUrl         String?
  sourcePrompt      String?
  tokenCost         Int?
  errorMessage      String?
  provider          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tokenLedgerEntries TokenLedgerEntry[]
}

model PublishedPost {
  id            String    @id @default(cuid())
  brandId       String
  brand         Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  postType      String
  caption       String?
  platform      String    @default("Instagram")
  status        String    @default("draft")
  scheduledDate DateTime?
  notes         String?
  thumbnailUrl  String?
  jsonPayload   String?
  postNumber    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  media PublishedPostMedia[]

  comments PublishedPostComment[]

  @@index([brandId, platform])
}

model PublishedPostMedia {
  id              String        @id @default(cuid())
  publishedPostId String
  publishedPost   PublishedPost @relation(fields: [publishedPostId], references: [id], onDelete: Cascade)
  url             String
  mediaType       String
  order           Int
  fileType        String?
  fileName        String?
  createdAt       DateTime      @default(now())
}

model PublishedPostComment {
  id                String   @id @default(cuid())
  publishedPostId   String
  userId            String?
  workspaceReviewId String?
  authorName        String
  reviewerName      String?
  body              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  publishedPost   PublishedPost    @relation(fields: [publishedPostId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceReview WorkspaceReview? @relation(fields: [workspaceReviewId], references: [id], onDelete: SetNull)

  @@index([publishedPostId, createdAt])
  @@index([userId])
  @@index([workspaceReviewId])
}
